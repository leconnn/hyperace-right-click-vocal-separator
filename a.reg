Windows Registry Editor Version 5.00

; HyperACE Right-Click Vocal Separator registry template.
; Do not import this template directly. Run install_context_menu.ps1 instead;
; it replaces the two placeholders with this checkout's verified paths.

[HKEY_CURRENT_USER\Software\Classes\*\shell\hyperace]
"MUIVerb"="HyperACE"
"AppliesTo"=".wav OR .mp3 OR .aac OR .flac OR .ogg OR .wma OR .m4a OR .aiff OR .opus OR .alac OR .mp2 OR .mp1 OR .amr OR .ape OR .au OR .ra OR .tta"
"MultiSelectModel"="Document"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\hyperace\shell]

[HKEY_CURRENT_USER\Software\Classes\*\shell\hyperace\shell\instrumentals]
@="Separate instrumentals"

[HKEY_CURRENT_USER\Software\Classes\*\shell\hyperace\shell\instrumentals\command]
@="\"__PYTHONW__\" \"__HYPERACE_ROOT__\\vocal_remover.pyw\" \"instrumental\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\hyperace\shell\vocals]
@="Separate vocals"

[HKEY_CURRENT_USER\Software\Classes\*\shell\hyperace\shell\vocals\command]
@="\"__PYTHONW__\" \"__HYPERACE_ROOT__\\vocal_remover.pyw\" \"vocals\" \"%1\""
